                    await viewModel.changeDateRange(to: newRange)
                }
            }
        )) {
            ForEach(DateRange.allCases, id: \.self) { range in
                Text(range.rawValue).tag(range)
            }
        }
        .pickerStyle(.segmented)
    }
}

