<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bundle Identifier -->
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

	<!-- App Name -->
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>

	<key>CFBundleDisplayName</key>
	<string>Cravey</string>

	<!-- Bundle Executable -->
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>

	<!-- Bundle Package Type -->
	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<!-- Bundle Version -->
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>

	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- iOS Minimum Version -->
	<key>MinimumOSVersion</key>
	<string>18.0</string>

	<!-- App Category -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.healthcare-fitness</string>

	<!-- Supported Interface Orientations -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- iPad Orientations -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Launch Screen -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchScreenBackground</string>
		<key>UIImageName</key>
		<string>LaunchIcon</string>
	</dict>

	<!-- App Icon (using Asset Catalog) -->
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIcon</string>
			</array>
		</dict>
	</dict>

	<!-- Privacy - Health Data (if integrating with HealthKit later) -->
	<!-- Commented out for now
	<key>NSHealthShareUsageDescription</key>
	<string>Cravey can integrate with Health data to provide better insights.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Cravey can save your progress to Health data.</string>
	-->
</dict>
</plist>
